[sub_resource type="GDScript" id="GDScript_6b6tp"]
script/source = "extends Node2D

func _on_timer_tutorial_timeout() -> void:
	$Tutorial.visible = false


func _on_alvo_body_entered(body: Node2D) -> void:
	if body.name == 'Player':
		$Timer_Fase.start()
		

func _on_timer_fase_timeout() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/fase02.tscn\")
"

